{
  "name": "anime",
  "version": "1.6.5",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "description": "anime - 番剧搜索与多源播放",
  "author": "Anime",
  "scripts": {
    "start": "node scripts/run-flutter.mjs",
    "app": "node scripts/run-flutter.mjs",
    "app:dev": "cd flutter_app && flutter run -d windows",
    "fix:electron": "node scripts/ensure-electron.mjs --force",
    "android:www": "node scripts/prepare-android-www.mjs",
    "android:sync": "npm run android:www && npx cap sync android",
    "android:open": "npm run android:sync && npx cap open android",
    "android:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-flutter-windows.ps1 -Target android",
    "dist": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-flutter-windows.ps1",
    "dist:dir": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-flutter-windows.ps1",
    "legacy:server": "node server.mjs",
    "legacy:electron": "node scripts/run-app.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.7",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.7",
    "@capacitor/status-bar": "^7.0.6",
    "cheerio": "^1.2.0",
    "qrcode": "^1.5.4",
    "webtorrent": "^2.5.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.7",
    "electron": "^35.7.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.anime.app",
    "productName": "anime",
    "copyright": "Copyright © Anime",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "icons/**/*",
      "server/**/*",
      "client/**/*",
      "server.mjs",
      "app.js",
      "index.html",
      "styles.css",
      "manifest.webmanifest",
      "sw.js",
      "package.json",
      "scripts/ensure-electron.mjs",
      "scripts/run-app.mjs",
      "node_modules/**/*"
    ],
    "asar": false,
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "win": {
      "icon": "icons/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "anime",
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "language": "2052"
    }
  }
}
